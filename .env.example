# Used by `docker compose` (copy to .env) and as a reference for env vars
# when running Conduit directly.

# Credentials (PAT, tokens, API keys) are now managed in the UI at /credentials.
# They are stored encrypted in the data directory — no env vars needed per source.

# Optional: provide a stable Fernet encryption key for credentials.
# If not set, a key is auto-generated in the data directory on first start.
# It must be a Fernet key (32 random bytes, URL-safe base64). Generate with:
#   openssl rand -base64 32 | tr '+/' '-_'
# CONDUIT_SECRET_KEY=

# Qdrant connection (useful in Docker; default: http://localhost:6333)
# QDRANT_URL=http://localhost:6333

# Web server bind address. Defaults to 127.0.0.1 (loopback only — avoids the
# Windows "allow network access" firewall prompt for local runs), or 0.0.0.0
# when running in a container so the port mapping works. Set it only to
# override that.
# CONDUIT_HOST=127.0.0.1

# Data directory (defaults to current working directory)
# CONDUIT_DATA_DIR=/data

# Embedding/preprocessing connection — also editable on the Settings page
# when not set here. Under Docker Compose the base URLs point at the bundled
# ollama service, and the models are also what setup downloads. Changing
# EMBEDDING_MODEL drops the index on the next start; re-sync afterwards.
# EMBEDDING_BASE_URL=http://localhost:11434/v1
# EMBEDDING_MODEL=nomic-embed-text-v2-moe
# PREPROCESSING_BASE_URL=http://localhost:11434/v1
# PREPROCESSING_MODEL=llama3.2:3b

# Sync performance tuning (see docs/configuration.md).
# EMBEDDING_CONCURRENCY=4
# PREPROCESSING_CONCURRENCY=4

# ── Docker Compose only ─────────────────────────────────────────────────────
# GPU for Ollama when running from a clone (installing from the GitHub URL,
# pass the overlay as a second -f instead — see docs/installation.md).
# COMPOSE_PATH_SEPARATOR=:
# COMPOSE_FILE=docker-compose.yml:docker-compose.nvidia.yml
# COMPOSE_FILE=docker-compose.yml:docker-compose.amd.yml

# Host port for the Conduit UI and /mcp.
# CONDUIT_PORT=8000

# Folder with extra trusted CA certs (PEM), e.g. from
# scripts/export-ca-certs.ps1. Use an absolute path when installing from the
# GitHub URL; the default ./certs then points into Compose's clone.
# CONDUIT_CERTS_DIR=C:\Users\you\conduit\certs

# Corporate proxy for model pulls and source syncs. Add internal hosts (e.g.
# an on-prem Azure DevOps) to NO_PROXY; compose service names are always
# included.
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
# NO_PROXY=.corp.example.com

# Ollama tuning — keep NUM_PARALLEL in step with the concurrency values above.
# OLLAMA_NUM_PARALLEL=4
# OLLAMA_MAX_LOADED_MODELS=2
# OLLAMA_KEEP_ALIVE=30m
