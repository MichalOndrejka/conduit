# Credentials (PAT, tokens, API keys) are now managed in the UI at /credentials.
# They are stored encrypted in the data directory — no env vars needed per source.

# Optional: provide a stable Fernet encryption key for credentials.
# If not set, a key is auto-generated in the data directory on first start.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# CONDUIT_SECRET_KEY=

# Qdrant connection (useful in Docker; defaults: localhost:6333)
# QDRANT_HOST=localhost
# QDRANT_PORT=6333

# Web server bind address (defaults to 127.0.0.1, loopback only — avoids the
# Windows "allow network access" firewall prompt for local runs). Docker
# compose sets this to 0.0.0.0 so the container's port mapping works.
# CONDUIT_HOST=127.0.0.1

# Data directory (defaults to current working directory)
# CONDUIT_DATA_DIR=/data

# Ollama models to auto-pull for the bundled `ollama` compose service
# (see docker-compose.yml/.hub.yml). Also used directly as the conduit
# service's EMBEDDING_MODEL/PREPROCESSING_MODEL.
# EMBEDDING_MODEL=nomic-embed-text-v2-moe
# PREPROCESSING_MODEL=llama3.2:3b

# Sync performance tuning (see README "Sync performance" section). Defaults
# shown are already applied by docker-compose.yml/.hub.yml.
# EMBEDDING_CONCURRENCY=4
# PREPROCESSING_CONCURRENCY=4
# OLLAMA_NUM_PARALLEL=4
# OLLAMA_MAX_LOADED_MODELS=2
# OLLAMA_KEEP_ALIVE=30m
