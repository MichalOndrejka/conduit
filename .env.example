# Used by `docker compose` (copy to .env) and as a reference for env vars
# when running Conduit directly.

# Credentials (PAT, tokens, API keys) are now managed in the UI at /credentials.
# They are stored encrypted in the data directory — no env vars needed per source.

# Qdrant connection (useful in Docker; default: http://localhost:6333)
# QDRANT_URL=http://localhost:6333

# Web server bind address. Defaults to 127.0.0.1 (loopback only — avoids the
# Windows "allow network access" firewall prompt for local runs), or 0.0.0.0
# when running in a container so the port mapping works. Set it only to
# override that.
# CONDUIT_HOST=127.0.0.1

# Data directory (defaults to /data in the container; locally, the per-user
# folder: %AppData%\Conduit, ~/Library/Application Support/Conduit or
# ~/.config/conduit)
# CONDUIT_DATA_DIR=/data

# Embedding/preprocessing connection — normally set on the Settings page; an
# env var here overrides Settings on every start. Docker Compose doesn't pass
# these, so under Compose use the Settings page (first-run default: the host's
# Ollama at http://host.docker.internal:11434/v1). Changing the embedding
# model drops the index; re-sync afterwards.
# EMBEDDING_BASE_URL=http://localhost:11434/v1
# EMBEDDING_MODEL=nomic-embed-text-v2-moe
# PREPROCESSING_BASE_URL=http://localhost:11434/v1
# PREPROCESSING_MODEL=llama3.2:3b

# Sync performance tuning (see docs/configuration.md).
# EMBEDDING_CONCURRENCY=4
# PREPROCESSING_CONCURRENCY=4

# ── Docker Compose only ─────────────────────────────────────────────────────
# Host port for the Conduit UI and /mcp (published on 127.0.0.1 only).
# CONDUIT_PORT=8000

# Corporate proxy for source syncs. Add internal hosts (e.g. an on-prem Azure
# DevOps) to NO_PROXY; compose service names and host.docker.internal are
# always included. Model downloads are made by the host's Ollama, which needs
# HTTPS_PROXY set in its own environment (see docs/customization.md).
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
# NO_PROXY=.corp.example.com

# Ollama tuning (OLLAMA_NUM_PARALLEL, OLLAMA_MAX_LOADED_MODELS,
# OLLAMA_KEEP_ALIVE) is set on the host's Ollama, not here — see
# docs/customization.md.
